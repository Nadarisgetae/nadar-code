{
  "name": "nadar-code-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "desktop": "npm --prefix apps/desktop start",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build:win",
    "cli": "npm --prefix apps/cli start",
    "build": "npm --prefix packages/core run build && npm --prefix apps/cli run build && npm --prefix apps/desktop run build:renderer"
  }
}
